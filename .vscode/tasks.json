{
  "version": "2.0.0",
  "tasks": 
  [
    // Debug
    {
      "type": "shell",
      "label": "Debug",
      "problemMatcher": ["$gcc"],
      "command": "echo Building Debug...",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },

      "windows": {
        "command": "${workspaceFolder}/EmpyWin.bat",
        "args": ["Debug"]
      },

      "linux": {
        "command": "${workspaceFolder}/EmpyLinux.sh",
        "args": ["Debug"]
      }
    },    
    // Release 
    {
      "type": "shell",
      "label": "Release",
      "problemMatcher": ["$gcc"],
      "command": "echo Building Release...",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": false },

      "windows": {
        "command": "${workspaceFolder}/EmpyWin.bat",
        "args": ["Release"]
      },

      "linux": {
        "command": "${workspaceFolder}/EmpyLinux.sh",
        "args": ["Release"]
      }
    }
  ]
}
